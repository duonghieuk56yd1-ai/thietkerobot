<?xml version="1.0"?>
<!--
  Tích hợp Gazebo Harmonic (gz-sim 8): ma sát bề mặt, plugin điều khiển và cảm biến.
  Toàn bộ topic gz được đặt tên tuyệt đối để ros_gz_bridge ánh xạ 1-1 sang ROS 2.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Ma sát bề mặt ===================== -->
  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1.0e6</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>1.0e6</kp>
    <kd>100.0</kd>
    <minDepth>0.001</minDepth>
  </gazebo>
  <!-- Bánh tự lựa: ma sát thấp µ = 0.01 -->
  <gazebo reference="caster_front_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="caster_rear_link">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <!-- Mặt băng cao su -->
  <gazebo reference="conveyor_belt_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <!-- Giữ nguyên link băng tải (không gộp vào khay) để TrackController điều khiển được -->
  <gazebo reference="conveyor_belt_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <!-- ===================== LiDAR 360° (gpu_lidar) ===================== -->
  <!-- 360 tia, độ phân giải 1°: góc từ -180° đến +179° (max = π - 2π/360). -->
  <gazebo reference="laser_frame">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>laser_frame</gz_frame_id>
      <topic>/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.12413936</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.3</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ===================== IMU 9 trục ===================== -->
  <!-- Gia tốc kế 3 trục + con quay 3 trục (+ hướng) → /imu ; từ kế 3 trục → /imu/mag -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <imu>
        <enable_orientation>true</enable_orientation>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-7</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-7</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>2.0e-4</stddev><bias_mean>7.5e-6</bias_mean><bias_stddev>8.0e-7</bias_stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>1.7e-2</stddev><bias_mean>0.1</bias_mean><bias_stddev>1.0e-3</bias_stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
    <sensor name="magnetometer" type="magnetometer">
      <gz_frame_id>imu_link</gz_frame_id>
      <topic>/imu/mag</topic>
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <magnetometer>
        <x><noise type="gaussian"><mean>0.0</mean><stddev>1.0e-7</stddev></noise></x>
        <y><noise type="gaussian"><mean>0.0</mean><stddev>1.0e-7</stddev></noise></y>
        <z><noise type="gaussian"><mean>0.0</mean><stddev>1.0e-7</stddev></noise></z>
      </magnetometer>
    </sensor>
  </gazebo>

  <!-- ===================== Plugin cấp model ===================== -->
  <gazebo>
    <!-- Differential Drive: /cmd_vel → bánh ; xuất /odom + TF odom → base_footprint @ 50 Hz -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <!-- Giới hạn vận tốc -->
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>1.5</max_angular_velocity>
      <min_angular_velocity>-1.5</min_angular_velocity>
      <!-- Giới hạn gia tốc -->
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>

    <!-- Nâng/hạ đồng bộ 4 trụ: một controller cho cả 4 khớp, cùng nhận lệnh vị trí từ /lift_cmd.
         use_velocity_commands = true: bộ điều khiển phát lệnh vận tốc tới đích,
         bị chặn bởi cmd_max/cmd_min → vận tốc nâng/hạ tối đa 0.1 m/s. -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>lift_fl_joint</joint_name>
      <joint_name>lift_fr_joint</joint_name>
      <joint_name>lift_rl_joint</joint_name>
      <joint_name>lift_rr_joint</joint_name>
      <topic>/lift_cmd</topic>
      <use_velocity_commands>true</use_velocity_commands>
      <cmd_max>${lift_velocity}</cmd_max>
      <cmd_min>${-lift_velocity}</cmd_min>
      <initial_position>0.0</initial_position>
    </plugin>

    <!-- Băng tải tháo dỡ hàng: lệnh vận tốc mặt băng (m/s, dương = đẩy hàng ra phía trước) -->
    <plugin filename="gz-sim-track-controller-system" name="gz::sim::systems::TrackController">
      <link>conveyor_belt_link</link>
      <velocity_topic>/conveyor_cmd</velocity_topic>
      <odometry_topic>/conveyor_odom</odometry_topic>
      <odometry_publish_frequency>10</odometry_publish_frequency>
      <min_velocity>-0.3</min_velocity>
      <max_velocity>0.3</max_velocity>
      <min_acceleration>-0.5</min_acceleration>
      <max_acceleration>0.5</max_acceleration>
    </plugin>

    <!-- Trạng thái khớp bánh xe + trụ nâng → /joint_states -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
      <joint_name>lift_fl_joint</joint_name>
      <joint_name>lift_fr_joint</joint_name>
      <joint_name>lift_rl_joint</joint_name>
      <joint_name>lift_rr_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
