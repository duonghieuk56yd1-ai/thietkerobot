<?xml version="1.0"?>
<!-- Bưu phẩm thử nghiệm cho robot chia chọn: hộp 0.30 × 0.22 × 0.12 m, 1.5 kg, µ = 0.5 -->
<sdf version="1.9">
  <model name="parcel">
    <link name="link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.00785</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.01305</iyy><iyz>0</iyz>
          <izz>0.0173</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.30 0.22 0.12</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>0.5</mu><mu2>0.5</mu2></ode>
            <bullet><friction>0.5</friction><friction2>0.5</friction2></bullet>
          </friction>
        </surface>
      </collision>
      <visual name="carton">
        <geometry><box><size>0.30 0.22 0.12</size></box></geometry>
        <material>
          <ambient>0.62 0.45 0.27 1</ambient>
          <diffuse>0.72 0.53 0.32 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <!-- Nhãn vận đơn có mã vạch -->
      <visual name="label">
        <pose>0.02 0 0.0605 0 0 0</pose>
        <geometry><box><size>0.12 0.10 0.001</size></box></geometry>
        <material>
          <ambient>0.95 0.95 0.95 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>
      <visual name="barcode">
        <pose>0.02 0 0.0612 0 0 0</pose>
        <geometry><box><size>0.06 0.08 0.001</size></box></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
