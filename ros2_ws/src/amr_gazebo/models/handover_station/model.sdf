<?xml version="1.0"?>
<!--
  Trạm trao hàng (tĩnh): mặt con lăn cao 0.67 m, bằng mặt băng tải AMR khi nâng hết hành trình.
  Robot tiến vào từ phía -x của trạm. Mặt trạm nhô 0.15 m về phía -x (công-xôn) để thân đế
  Ø0.60 m chui dưới, đưa mép khay sát mép trạm. Con lăn được mô phỏng bằng ma sát thấp µ = 0.05.
  Vị trí dừng đề xuất của tâm robot: x = -0.63 m (vạch vàng trên sàn).
-->
<sdf version="1.9">
  <model name="handover_station">
    <static>true</static>
    <link name="link">
      <!-- Mặt trạm 0.70 × 0.60 × 0.05 m, mặt trên z = 0.67 -->
      <collision name="top">
        <pose>0 0 0.645 0 0 0</pose>
        <geometry><box><size>0.70 0.60 0.05</size></box></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="top_v">
        <pose>0 0 0.640 0 0 0</pose>
        <geometry><box><size>0.70 0.60 0.04</size></box></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.35 0.35 0.38 1</diffuse></material>
      </visual>
      <!-- Con lăn (hình ảnh) -->
      <visual name="roller_1"><pose>-0.30 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <visual name="roller_2"><pose>-0.20 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <visual name="roller_3"><pose>-0.10 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <visual name="roller_4"><pose> 0.00 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <visual name="roller_5"><pose> 0.10 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <visual name="roller_6"><pose> 0.20 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <visual name="roller_7"><pose> 0.30 0 0.65 1.5708 0 0</pose><geometry><cylinder><radius>0.02</radius><length>0.56</length></cylinder></geometry><material><ambient>0.7 0.72 0.75 1</ambient><diffuse>0.8 0.82 0.85 1</diffuse></material></visual>
      <!-- Gờ bên + chặn cuối -->
      <collision name="rail_left"><pose>0  0.29 0.695 0 0 0</pose><geometry><box><size>0.70 0.02 0.05</size></box></geometry></collision>
      <collision name="rail_right"><pose>0 -0.29 0.695 0 0 0</pose><geometry><box><size>0.70 0.02 0.05</size></box></geometry></collision>
      <collision name="end_stop"><pose>0.34 0 0.72 0 0 0</pose><geometry><box><size>0.02 0.60 0.10</size></box></geometry></collision>
      <visual name="rail_left_v"><pose>0  0.29 0.695 0 0 0</pose><geometry><box><size>0.70 0.02 0.05</size></box></geometry><material><ambient>0.9 0.75 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual>
      <visual name="rail_right_v"><pose>0 -0.29 0.695 0 0 0</pose><geometry><box><size>0.70 0.02 0.05</size></box></geometry><material><ambient>0.9 0.75 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual>
      <visual name="end_stop_v"><pose>0.34 0 0.72 0 0 0</pose><geometry><box><size>0.02 0.60 0.10</size></box></geometry><material><ambient>0.9 0.75 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual>
      <!-- 4 chân trạm (lùi 0.15 m so với mép phía robot) -->
      <collision name="leg_1"><pose>-0.17  0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry></collision>
      <collision name="leg_2"><pose>-0.17 -0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry></collision>
      <collision name="leg_3"><pose> 0.32  0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry></collision>
      <collision name="leg_4"><pose> 0.32 -0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry></collision>
      <visual name="leg_1_v"><pose>-0.17  0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      <visual name="leg_2_v"><pose>-0.17 -0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      <visual name="leg_3_v"><pose> 0.32  0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      <visual name="leg_4_v"><pose> 0.32 -0.27 0.31 0 0 0</pose><geometry><box><size>0.05 0.05 0.62</size></box></geometry><material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material></visual>
      <!-- Vạch dừng màu vàng trên sàn (chỉ hình ảnh) -->
      <visual name="dock_mark_front"><pose>-0.33 0 0.001 0 0 0</pose><geometry><box><size>0.03 0.60 0.002</size></box></geometry><material><ambient>0.9 0.75 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual>
      <visual name="dock_mark_center"><pose>-0.63 0 0.001 0 0 0</pose><geometry><box><size>0.03 0.30 0.002</size></box></geometry><material><ambient>0.9 0.75 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
