<?xml version="1.0"?>
<!-- Trạm sạc (tĩnh): tấm tiếp điểm đồng ở mặt +x, cao 0.08 – 0.16 m, rộng 0.40 m — khớp với mảng sạc trước của AMR -->
<sdf version="1.9">
  <model name="charging_dock">
    <static>true</static>
    <link name="link">
      <collision name="body"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.20 0.60 0.30</size></box></geometry></collision>
      <visual name="body_v"><pose>0 0 0.15 0 0 0</pose><geometry><box><size>0.20 0.60 0.30</size></box></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.2 0.2 0.22 1</diffuse></material></visual>
      <visual name="contacts_v"><pose>0.103 0 0.12 0 0 0</pose><geometry><box><size>0.006 0.40 0.08</size></box></geometry><material><ambient>0.75 0.50 0.15 1</ambient><diffuse>0.85 0.58 0.20 1</diffuse><specular>0.6 0.5 0.3 1</specular></material></visual>
      <visual name="status_led"><pose>0.101 0 0.26 0 0 0</pose><geometry><box><size>0.004 0.10 0.02</size></box></geometry><material><ambient>0 0.8 0.2 1</ambient><diffuse>0 1 0.3 1</diffuse><emissive>0 0.8 0.2 1</emissive></material></visual>
      <visual name="floor_plate"><pose>0.35 0 0.003 0 0 0</pose><geometry><box><size>0.50 0.70 0.006</size></box></geometry><material><ambient>0.9 0.75 0.0 1</ambient><diffuse>1.0 0.85 0.0 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
