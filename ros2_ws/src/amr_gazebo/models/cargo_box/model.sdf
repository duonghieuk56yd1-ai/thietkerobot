<?xml version="1.0"?>
<!-- Thùng hàng thử nghiệm: lập phương 0.40 m, 20 kg, hệ số ma sát µ = 0.8 -->
<sdf version="1.9">
  <model name="cargo_box">
    <link name="link">
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>20.0</mass>
        <!-- I = m (a² + a²) / 12 = 20 × 0.32 / 12 -->
        <inertia>
          <ixx>0.5333</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.5333</iyy><iyz>0</iyz>
          <izz>0.5333</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.40 0.40 0.40</size></box></geometry>
        <surface>
          <friction>
            <ode><mu>0.8</mu><mu2>0.8</mu2></ode>
            <bullet><friction>0.8</friction><friction2>0.8</friction2></bullet>
          </friction>
          <contact>
            <ode><kp>1.0e6</kp><kd>100.0</kd><min_depth>0.001</min_depth><max_vel>0.1</max_vel></ode>
          </contact>
        </surface>
      </collision>
      <visual name="carton">
        <geometry><box><size>0.40 0.40 0.40</size></box></geometry>
        <material>
          <ambient>0.62 0.45 0.27 1</ambient>
          <diffuse>0.72 0.53 0.32 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
      <!-- Băng keo dán ngang thùng -->
      <visual name="tape">
        <geometry><box><size>0.07 0.402 0.402</size></box></geometry>
        <material>
          <ambient>0.80 0.72 0.55 1</ambient>
          <diffuse>0.90 0.82 0.62 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
